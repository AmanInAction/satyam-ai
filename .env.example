# Server Port
PORT=3000

# Gemini API Key (Server-side, if Gemini provider is configured)
GEMINI_API_KEY=

# Amazon Bedrock Configuration (Server-side)
# Region: defaults to ap-south-1 (Mumbai)
AWS_REGION=ap-south-1
BEDROCK_REGION=ap-south-1
# Model: defaults to anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Credentials: if left empty, system operates in MockLLM/deterministic fallback mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Timeout: defaults to 10000ms
BEDROCK_TIMEOUT_MS=10000

# Google Safe Browsing API v4 (Optional, server-side)
# If empty, system uses Cloudflare Security DoH threat intelligence and deterministic URL rules
SAFE_BROWSING_API_KEY=

# Google Fact Check Tools API (Optional, server-side)
# If empty, system uses Wikipedia Attributable Knowledge Retrieval
GOOGLE_FACT_CHECK_API_KEY=
